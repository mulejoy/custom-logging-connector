# Custom Logging Connector — Environment Variables
# Copy this file to .env and fill in values. Never commit .env to git.

# ─── Anypoint Platform credentials (required for mvn deploy) ─────────────────
ANYPOINT_USERNAME=your_username@example.com
ANYPOINT_PASSWORD=your_anypoint_password

# ─── Organization configuration (set in pom.xml groupId, not here) ───────────
# Your Anypoint Organization ID is visible at:
# Anypoint Platform → Access Management → Organization → Organization ID
# ANYPOINT_ORG_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ─── Runtime JVM options (set in Mule app's wrapper.conf or Runtime Manager) ──
# Timezone for log timestamps. Defaults to UTC if not set.
# JSON_LOGGER_TIMEZONE=UTC

# Date format for timestamps (Joda-Time pattern). Defaults to ISO 8601.
# JSON_LOGGER_DATEFORMAT=yyyy-MM-dd'T'HH:mm:ss.SSSZ
